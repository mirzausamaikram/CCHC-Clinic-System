<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>CCHC Custom Tags</description>
    <tlib-version>1.0</tlib-version>
    <short-name>cchc</short-name>
    <uri>http://cchc/tags</uri>

    <tag>
        <name>hasRole</name>
        <tag-class>com.cchc.tag.HasRoleTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <name>value</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.String</type>
        </attribute>
    </tag>

    <tag>
        <name>username</name>
        <tag-class>com.cchc.tag.UsernameTag</tag-class>
        <body-content>empty</body-content>
    </tag>

    <tag>
        <name>unreadCount</name>
        <tag-class>com.cchc.tag.UnreadCountTag</tag-class>
        <body-content>empty</body-content>
    </tag>
</taglib>
