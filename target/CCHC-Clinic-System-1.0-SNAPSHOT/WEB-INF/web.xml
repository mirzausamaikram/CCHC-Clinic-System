<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
   version="5.0"
   metadata-complete="true">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.cchc.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.cchc.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.cchc.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppointmentBookingServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AppointmentBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentBookingServlet</servlet-name>
        <url-pattern>/patient/appointments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyBookingsServlet</servlet-name>
        <servlet-class>com.cchc.servlet.MyBookingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyBookingsServlet</servlet-name>
        <url-pattern>/patient/my-bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyAppointmentsServlet</servlet-name>
        <servlet-class>com.cchc.servlet.MyAppointmentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyAppointmentsServlet</servlet-name>
        <url-pattern>/my_appointments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RescheduleServlet</servlet-name>
        <servlet-class>com.cchc.servlet.RescheduleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RescheduleServlet</servlet-name>
        <url-pattern>/patient/reschedule</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientQueueServlet</servlet-name>
        <servlet-class>com.cchc.servlet.PatientQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientQueueServlet</servlet-name>
        <url-pattern>/patient/queue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientQueueStatusServlet</servlet-name>
        <servlet-class>com.cchc.servlet.PatientQueueStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientQueueStatusServlet</servlet-name>
        <url-pattern>/patient/queue-status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/staff/attendance</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QueueManagementServlet</servlet-name>
        <servlet-class>com.cchc.servlet.QueueManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QueueManagementServlet</servlet-name>
        <url-pattern>/staff/queue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>JoinQueueServlet</servlet-name>
        <servlet-class>com.cchc.servlet.JoinQueueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JoinQueueServlet</servlet-name>
        <url-pattern>/staff/join-queue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>QueueProgressionServlet</servlet-name>
        <servlet-class>com.cchc.servlet.QueueProgressionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>QueueProgressionServlet</servlet-name>
        <url-pattern>/staff/queue-progression</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApprovalServlet</servlet-name>
        <servlet-class>com.cchc.servlet.ApprovalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApprovalServlet</servlet-name>
        <url-pattern>/staff/approval</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffIssueServlet</servlet-name>
        <servlet-class>com.cchc.servlet.StaffIssueServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffIssueServlet</servlet-name>
        <url-pattern>/staff/report-issue</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>com.cchc.servlet.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/notifications</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PolicyServlet</servlet-name>
        <servlet-class>com.cchc.servlet.PolicyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PolicyServlet</servlet-name>
        <url-pattern>/admin/policy</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.cchc.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/patient/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountProfileServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AccountProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountProfileServlet</servlet-name>
        <url-pattern>/account/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminReportServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AdminReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminReportServlet</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminIncidentLogServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AdminIncidentLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminIncidentLogServlet</servlet-name>
        <url-pattern>/admin/incident-logs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminConfigureServlet</servlet-name>
        <servlet-class>com.cchc.servlet.AdminConfigureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminConfigureServlet</servlet-name>
        <url-pattern>/admin/configure</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CsvImportServlet</servlet-name>
        <servlet-class>com.cchc.servlet.CsvImportServlet</servlet-class>
        <multipart-config>
            <max-file-size>1048576</max-file-size>
            <max-request-size>2097152</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>CsvImportServlet</servlet-name>
        <url-pattern>/admin/csv-import</url-pattern>
    </servlet-mapping>

</web-app>
